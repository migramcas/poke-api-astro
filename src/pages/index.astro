---
import MainLayout from "../layout/MainLayout.astro";
import type {PokemonListResponse} from "../interfces/pokemon-list-response";
import PokemonCard from "../components/pokemon/PokemonCard.astro";
const title = 'Pikemon Static | Home';

const resp = await fetch("https://pokeapi.co/api/v2/pokemon");
const data = await resp.json() as PokemonListResponse;
---

<MainLayout title={title}>
    <h1 class="font-semibold mb-2 text-xl text-center">Listado de pokemons</h1>
    <hr class="mb-3"/>

    <section
            aria-label="Listado de pókemons"
            class="grid grid-cols-1 sm:grid-cols-3 md:grid-cols-5 gap-3"
    >
        {data.results.map(pokemon => (
            <PokemonCard
                    name={pokemon.name}
                    url={pokemon.url}
            />
        ))}
    </section>
</MainLayout>
